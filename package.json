{
	"name": "book-search-covers",
	"version": "0.1.0",
	"description": "Search books and create notes from a template, with high-resolution covers.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"format": "prettier --write \"src/**/*.ts\""
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"books",
		"book-search"
	],
	"author": "lksrpp",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.5",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "^1.7.0",
		"prettier": "^3.0.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.0.0",
		"vitest": "^4.1.8"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	}
}
